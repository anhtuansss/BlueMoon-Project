# BlueMoon Backend Environment Variables
# Copy this file to .env or set environment variables in your operating system / IDE

# Server
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bluemoon_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JPA Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
